# 複製成 .env 後填入；.env 不會進 Git

# 本機：docker compose up -d db（見 docker-compose.yml）；上線改填 Supabase 的連線字串
DATABASE_URL=postgres://healthcare:healthcare@localhost:5433/wjcch

# 後台網址（Google OAuth 重新導向 URI 為 {APP_URL}/api/auth/google/callback）
APP_URL=http://localhost:3000

# 最高管理者首次登入用的帳密；密碼以 npm run hash-password 產生雜湊後貼上
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Google Cloud Console 建立的 OAuth 用戶端（網頁應用程式）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 前台人機驗證：Google Cloud 的 Web／Score-based reCAPTCHA（Enterprise API v1）
# SITE_KEY 是公開設定，由伺服器僅傳此值到前台；API_KEY 為伺服器密鑰，不得加 NEXT_PUBLIC_。
# 完整建立與部署步驟：docs/setup/recaptcha.md
RECAPTCHA_SITE_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=
# 僅 hostname，不含 https://、連接埠或路徑；正式改為 wjcch-healthcare.vercel.app
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,127.0.0.1
RECAPTCHA_MIN_SCORE=0.5
# 只限未在 Vercel 上的 npm run dev；正式與預覽環境永遠不能略過。
RECAPTCHA_DEV_BYPASS=false
