# 複製成 .env 後填入；.env 不會進 Git

# 本機：docker compose up -d db（見 docker-compose.yml）；上線改填 Supabase 的連線字串
DATABASE_URL=postgres://healthcare:healthcare@localhost:5433/healthcare

# 後台網址（Google OAuth 重新導向 URI 為 {APP_URL}/api/auth/google/callback）
APP_URL=http://localhost:3000

# 最高管理者首次登入用的帳密；密碼以 npm run hash-password 產生雜湊後貼上
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Google Cloud Console 建立的 OAuth 用戶端（網頁應用程式）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
